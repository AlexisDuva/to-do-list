{
  "info": {
    "name": "To-Do List API",
    "description": "Requests for docs/api-documentation.md. Set baseUrl (default http://localhost:8080). projectId/tagId/taskId variables are set manually after creating resources, to chain requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "projectId", "value": "1" },
    { "key": "tagId", "value": "1" },
    { "key": "taskId", "value": "1" }
  ],
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Get project by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Work\"\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal\"\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tags"
          }
        },
        {
          "name": "Create tag",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"errand\"\n}"
            },
            "url": "{{baseUrl}}/api/tags"
          }
        },
        {
          "name": "Update tag",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"urgent\"\n}"
            },
            "url": "{{baseUrl}}/api/tags/{{tagId}}"
          }
        },
        {
          "name": "Delete tag",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tags/{{tagId}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks (no filter)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "List tasks (filtered + sorted)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=incomplete&projectId={{projectId}}&tagId={{tagId}}&priority=HIGH&search=grocer&sortBy=dueDate&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "status", "value": "incomplete" },
                { "key": "projectId", "value": "{{projectId}}" },
                { "key": "tagId", "value": "{{tagId}}" },
                { "key": "priority", "value": "HIGH" },
                { "key": "search", "value": "grocer" },
                { "key": "sortBy", "value": "dueDate" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get task by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"dueDate\": \"2026-09-30\",\n  \"priority\": \"HIGH\",\n  \"projectId\": {{projectId}},\n  \"tagIds\": [{{tagId}}]\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries (updated)\",\n  \"description\": \"Milk, eggs, bread, butter\",\n  \"dueDate\": \"2026-10-02\",\n  \"priority\": \"MEDIUM\",\n  \"projectId\": {{projectId}},\n  \"tagIds\": [{{tagId}}]\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Mark task complete",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
          }
        },
        {
          "name": "Mark task incomplete",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/incomplete"
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "404 - Get task by unknown id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/999999"
          }
        },
        {
          "name": "404 - Get project by unknown id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/999999"
          }
        },
        {
          "name": "404 - Update tag with unknown id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"whatever\"\n}"
            },
            "url": "{{baseUrl}}/api/tags/999999"
          }
        },
        {
          "name": "400 - Create project with blank name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "400 - Create tag with missing name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/tags"
          }
        },
        {
          "name": "400 - Create task with missing title",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"no title given\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "400 - Create task with blank title",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "404 - Create task with unknown projectId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Task with bad project\",\n  \"projectId\": 999999\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        }
      ]
    }
  ]
}
